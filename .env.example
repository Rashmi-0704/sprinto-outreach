# ---- AI (Gemini extracts facts and writes; code decides) ----
# Google AI Studio > Get API key. Or set OPENROUTER_API_KEY instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used when the main model is overloaded
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
# Max Gemini calls per minute (free tier is low)
GEMINI_RPM=10

# ---- Step 4: point of contact ----
# Option A: Hunter.io Domain Search (free tier, 25 searches/month). Empty = use data/contacts.json (Option B, Apollo by hand)
HUNTER_API_KEY=

# ---- Step 7: Gmail ----
# Google Account > Security > 2-Step Verification > App passwords. Create one for "Mail".
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Every email goes here, never to the prospect (the case says: hardcode to your own address)
MY_EMAIL=
# true = clean, validated drafts send themselves. false = every draft waits in Drafts.
AUTO_SEND=true
# Name used to sign the emails
SENDER_NAME=Rashmi

# ---- Storage ----
# Neon Postgres connection string. Empty = local file .data/store.json (fine for local runs, not for Vercel)
DATABASE_URL=

# ---- Optional ----
# If set, the site asks for this password (any username)
APP_PASSWORD=
# Max domains per web run
MAX_DOMAINS_PER_RUN=10
